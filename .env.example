# Tavily — search provider (https://app.tavily.com)
TAVILY_API_KEY=

# Groq — LLM provider (https://console.groq.com)
GROQ_API_KEY=

# App-wide
LOG_LEVEL=INFO
ENVIRONMENT=development

# Max time (seconds) SearchOrchestrator waits per sub-query before
# giving up on it and moving on with whatever else succeeded.
SEARCH_TIMEOUT_SECONDS=10.0

# How many results Tavily is asked to return per sub-query.
MAX_SEARCH_RESULTS=5

# Hard ceiling (approx. tokens) on the total context ContextBuilder
# sends to the LLM across all sources combined.
CONTEXT_TOKEN_BUDGET=2500

# How many top-ranked sources ContextBuilder includes in the context
# at most, before the token budget is even considered.
MAX_CONTEXT_SOURCES=6

# Max time (seconds) ContextBuilder waits for a single full-page
# fetch (via ContentExtractor) before falling back to the snippet.
CONTENT_FETCH_TIMEOUT_SECONDS=10.0
