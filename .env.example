# Tavily — search provider (https://app.tavily.com)
TAVILY_API_KEY=

# Groq — LLM provider (https://console.groq.com)
GROQ_API_KEY=

# App-wide
# CRITICAL keeps the CLI's terminal output limited to the conversation
# itself. Set to INFO to see per-stage turn timings and HTTP request
# logs on stderr (Decision 13.3).
LOG_LEVEL=CRITICAL
ENVIRONMENT=development

# Max time (seconds) SearchOrchestrator waits per sub-query before
# giving up on it and moving on with whatever else succeeded.
SEARCH_TIMEOUT_SECONDS=10.0

# How many results Tavily is asked to return per sub-query.
MAX_SEARCH_RESULTS=5

# Hard ceiling (approx. tokens) on the total context ContextBuilder
# sends to the LLM across all sources combined.
CONTEXT_TOKEN_BUDGET=2500

# How many top-ranked sources ContextBuilder includes in the context
# at most, before the token budget is even considered.
MAX_CONTEXT_SOURCES=6

# Max time (seconds) ContextBuilder waits for a single full-page
# fetch (via ContentExtractor) before falling back to the snippet.
CONTENT_FETCH_TIMEOUT_SECONDS=10.0

# Small/fast Groq model used for query planning's structured-output call.
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Larger Groq model used for the final grounded answer (Phase 6+).
GROQ_CAPABLE_MODEL=llama-3.3-70b-versatile

# Max time (seconds) to wait for a single Groq call before giving up.
LLM_TIMEOUT_SECONDS=10.0

# Max time (seconds) EvaluationService waits for RAGAS scoring (both
# metrics, run concurrently) before giving up and returning a null score.
# A real successful call was measured at ~14.5s with zero retries, so this
# needs real headroom above that, not just above the happy path.
EVALUATION_TIMEOUT_SECONDS=30.0

# How long (seconds) a cached query plan stays valid for an identical
# (normalized) question before QueryPlanner calls Groq again.
QUERY_PLAN_CACHE_TTL_SECONDS=600.0

# How long (seconds) a cached search result stays valid for an identical
# sub-query + max_results before SearchOrchestrator calls Tavily again.
SEARCH_RESULT_CACHE_TTL_SECONDS=3600.0

# Max characters accepted for a single user question before ChatPipeline
# rejects it up front, without calling QueryPlanner at all.
MAX_QUERY_LENGTH=500

# Max attempts (including the first try) for a single Tavily/Groq call
# before giving up and raising a typed exception.
MAX_RETRY_ATTEMPTS=3

# Base backoff (seconds) between retry attempts for Tavily/Groq calls.
RETRY_BACKOFF_SECONDS=0.5
